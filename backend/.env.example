# ──────────────────────────────────────────────────────
#  ShopIQ Backend — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ──────────────────────────────────────────────────────

# ── Flask ──────────────────────────────────────────────
# Required in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-flask-secret-key-here

# ── JWT ────────────────────────────────────────────────
# Required in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-random-jwt-secret-key-here

# JWT token lifetime in seconds (default: 86400 = 24 hours)
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=86400

# ── Database ───────────────────────────────────────────
# Leave unset to use local SQLite (development only).
# For PostgreSQL: postgresql://user:password@host:5432/dbname
# DATABASE_URL=

# ── CORS ───────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Use * only for development. In production, set to your deployed frontend URL.
# Example: CORS_ORIGINS=https://shopiq.yourdomain.com
CORS_ORIGINS=http://localhost:5173

# ── Flask Environment ──────────────────────────────────
# Set to "production" on your server. This enables strict secret validation.
FLASK_ENV=development
